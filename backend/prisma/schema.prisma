generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String
  phone         String          @unique
  name          String
  role          Role            @default(CUSTOMER)
  refCode       String          @unique @map("ref_code")
  refCodeInput  String?         @map("ref_code_input")
  balancePoints Int             @default(0) @map("balance_points")
  refById       String?         @map("refBy")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  refreshTokens RefreshToken[]
  events        Event[]
  pointBuckets  PointsBucket[]
  pointLedgers  PointsLedger[]
  profile       Profile?
  promos        Promo[]
  salesOrders   Sales_Order[]
  refBy         User?           @relation("UserReferral", fields: [refById], references: [id])
  referrals     User[]          @relation("UserReferral")

  @@map("users")
}

model Profile {
  id        String    @id @default(cuid())
  dob       DateTime
  nik       String    @unique
  gender    String
  avatarUrl String    @map("avatar_url")
  userId    String    @unique @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Event {
  id          String        @id @default(cuid())
  eventTitle  String        @unique
  eventDate   DateTime      @map("event_date")
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  eventDesc   String        @map("event_desc")
  eventImg    String        @map("event_img")
  eventTnc    String        @map("event_tnc")
  lastBuyDate DateTime      @map("last_buy_date")
  lastBuyTime DateTime      @map("last_buy_time")
  isPublished Boolean       @default(false) @map("is_published")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  categoryId  Int           @unique @map("category_id")
  venueId     Int           @unique @map("venue_id")
  organizerId String        @map("organizer_id")
  eventPromo  EventPromo[]
  category    Category      @relation(fields: [categoryId], references: [id])
  organizer   User          @relation(fields: [organizerId], references: [id])
  venue       Venue         @relation(fields: [venueId], references: [id])
  ticketTypes TicketType[]

  @@map("events")
}

model Category {
  id        Int      @id @default(autoincrement())
  category  String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  events    Event[]

  @@map("categories")
}

model PointsLedger {
  id               Int                      @id @default(autoincrement())
  amount           Int
  transactionType  TransactionType          @map("transaction_type")
  createdAt        DateTime                 @default(now()) @map("created_at")
  source           EarnSource
  sourceId         String?                  @map("source_id")
  customerId       String                   @map("customer_id")
  deductionDetails PointsDeductionDetail[]
  customer         User                     @relation(fields: [customerId], references: [id])

  @@map("points_ledger")
}

model PointsBucket {
  id               Int                      @id @default(autoincrement())
  earned           Int
  remaining        Int
  expiredAt        DateTime                 @map("expired_at")
  earnedAt         DateTime                 @default(now()) @map("earned_at")
  customerId       String                   @map("customer_id")
  customer         User                     @relation(fields: [customerId], references: [id])
  deductionDetails PointsDeductionDetail[]

  @@map("points_bucket")
}

model PointsDeductionDetail {
  id             Int           @id @default(autoincrement())
  ledgerId       Int           @map("ledger_id")
  bucketId       Int           @map("bucket_id")
  amountRedeemed Int           @map("amount_redeemed")
  bucket         PointsBucket  @relation(fields: [bucketId], references: [id])
  ledger         PointsLedger  @relation(fields: [ledgerId], references: [id])

  @@map("points_deduction_details")
}

model Coupon {
  id           Int           @id @default(autoincrement())
  couponCode   String        @unique @map("coupon_code")
  couponTnc    String        @map("coupon_tnc")
  isUsed       Boolean       @default(false) @map("is_used")
  isRedeemed   Boolean       @default(false) @map("is_redeemed")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  promoId      Int           @map("promo_id")
  promo        Promo         @relation(fields: [promoId], references: [id])
  salesOrderId Sales_Order?

  @@map("coupon")
}

model Promo {
  id            Int               @id @default(autoincrement())
  promo_type    PromoTypes
  promo_name    String            @unique @map("promo_name")
  promo_tnc     String            @map("promo_tnc")
  discountType  PromoDiscountType @map("discount_type")
  discountValue Decimal           @map("discount_value")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  promoOwnerId  String            @map("promo_owner_id")
  coupons       Coupon[]
  eventPromos   EventPromo[]
  promoOwner    User              @relation(fields: [promoOwnerId], references: [id])

  @@map("promo")
}

model EventPromo {
  id      Int    @id @default(autoincrement())
  eventId String @map("event_id")
  promoId Int    @map("promo_id")
  event   Event  @relation(fields: [eventId], references: [id])
  promo   Promo  @relation(fields: [promoId], references: [id])

  @@map("event_promos")
}

model Venue {
  id            Int       @id @default(autoincrement())
  venueName     String    @map("venue_name")
  venueAddress  String    @map("venue_address")
  venueCity     String    @map("venue_city")
  venueState    String    @map("venue_state")
  venueZipCode  String    @map("venue_zip_code")
  venuePhone    String    @map("venue_phone")
  venueEmail    String    @map("venue_email")
  venueGMapsUrl String    @map("venue_gmaps_url")
  capacity      Int
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  events        Event[]

  @@map("venue")
}

model Sales_Order {
  id            String           @id @default(cuid())
  totalPrice    Int              @map("total_price")
  qtyTickets    Int              @map("qty_tickets")
  discounts     Int
  finalPrice    Int              @map("final_price")
  pointsUsed    Int              @map("points_used")
  status        SalesOrderStatus
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  customerId    String           @map("customer_id")
  paymentId     String           @unique @map("payment_id")
  couponId      Int              @unique @map("coupon_id")
  issuedTickets IssuedTicket[]
  coupon        Coupon          @relation(fields: [couponId], references: [id])
  customer      User             @relation(fields: [customerId], references: [id])
  payment       Payment         @relation(fields: [paymentId], references: [id])

  @@map("sales_order")
}

model TicketType {
  id            Int             @id @default(autoincrement())
  ticketType    String
  price         Int
  quota         Int
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  eventId       String          @map("event_id")
  issuedTickets IssuedTicket[]
  event         Event           @relation(fields: [eventId], references: [id])

  @@map("ticket_type")
}

model IssuedTicket {
  id           String       @id @default(cuid())
  ticketCode   String       @unique @map("ticket_code")
  isUsed       Boolean      @default(false) @map("is_used")
  usedAt       DateTime     @map("used_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  ticketTypeId Int          @map("ticket_type_id")
  salesOrderId String       @map("sales_order_id")
  salesOrder   Sales_Order @relation(fields: [salesOrderId], references: [id])
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@map("issued_tickets")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Int
  paymentMethod String        @map("payment_method")
  paymentProof  String        @map("payment_proof")
  paidAt        DateTime      @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  salesOrderId  Sales_Order?

  @@map("payments")
}

model RefreshToken {
  id          String   @id @default(cuid())
  jti         String   @unique
  tokenHash   String   @map("token_hash")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  revokedAt   DateTime?

  @@map("refresh_tokens")
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EarnSource {
  TRANSACTION
  REFERRAL
}

enum TransactionType {
  EARN
  REDEEM
  EXPIRED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

enum PromoTypes {
  PLATFORM
  ORGANIZER
}

enum SalesOrderStatus {
  WAITING_PAYMENT
  PAID
  CANCELLED
  CANCELLED_EXPIRED
}
